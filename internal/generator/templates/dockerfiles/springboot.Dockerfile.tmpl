FROM eclipse-temurin:17-jdk-alpine AS build
WORKDIR /app
COPY . .
RUN ./mvnw package -DskipTests || ./gradlew build -x test
RUN mkdir -p /app/dist && (cp target/*.jar /app/dist/app.jar 2>/dev/null || cp build/libs/*[!plain].jar /app/dist/app.jar 2>/dev/null || cp build/libs/*.jar /app/dist/app.jar 2>/dev/null)

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
RUN addgroup -S spring && adduser -S spring -G spring
COPY --from=build /app/dist/app.jar /app/app.jar
USER spring
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
